<world>
    <window width="1024" height="768" />
    <camera>
        <position x="0" y="70" z="150" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="10000" />
    </camera>

    <lights>
        <light type="point" posx="0" posy="0" posz="0" />
    </lights>

    <!-- Sun (center) -->
    <group> <!-- Sun Group -->
        <transform>
            <!-- Solo aplica rotación y escala al Sol -->
            <rotate time="60" x="0" y="1" z="0" />
            <scale x="8" y="8" z="8" />
        </transform>
        <models>
            <model file="sphere_1_20_20.3d" >
                <texture file="sunmap.jpg" />
                <color>
                    <diffuse R="0" G="0" B="0" /> <ambient R="0" G="0" B="0" /> <specular R="0" G="0" B="0" />
                    <emissive R="255" G="220" B="180" /> <shininess value="0" />
                </color>
            </model>
        </models>

        <!-- Planetary System Group (relative to Sun) -->
        <group>
            <transform> <!-- Empty transform, just grouping --> </transform>

            <!-- Mercury -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="8.8" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="15" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="100" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="0.38" y="0.38" z="0.38" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="mercurymap.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Venus -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="22.5" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="20" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="-120" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="0.95" y="0.95" z="0.95" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="venusmap.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Earth -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="36.5" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="28" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="10" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="1.0" y="1.0" z="1.0" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="earthmap1k.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Mars -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="68.7" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="38" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="11" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="0.53" y="0.53" z="0.53" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="mars_1k_color.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Jupiter -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="433" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="55" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="4" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="4.0" y="4.0" z="4.0" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="jupitermap.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Saturn -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="1075" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="75" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="4.5" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="3.5" y="3.5" z="3.5" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="saturnmap.jpg" /></model> </models>
                              <!-- Rings would be another GROUP nested inside THIS Scale & Model Group -->
                         </group>
                    </group>
                </group>
            </group>

            <!-- Uranus -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="3068" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="95" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group (Tilted) -->
                         <transform> <rotate time="-7" x="1" y="0" z="0" /> </transform> <!-- Tilt Axis -->
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="2.0" y="2.0" z="2.0" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="uranusmap.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Neptune -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="6019" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group -->
                    <transform> <translate x="115" y="0" z="0" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="7" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="1.9" y="1.9" z="1.9" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="neptunemap.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

            <!-- Pluto (Dwarf Planet) -->
            <group> <!-- 1. Orbit Rotation Group -->
                <transform> <rotate time="9056" x="0" y="1" z="0" /> </transform>
                <group> <!-- 2. Translate Group (Inclined) -->
                    <transform> <translate x="135" y="5" z="10" /> </transform>
                    <group> <!-- 3. Self Rotation Group -->
                         <transform> <rotate time="-30" x="0" y="1" z="0" /> </transform>
                         <group> <!-- 4. Scale & Model Group -->
                              <transform> <scale x="0.18" y="0.18" z="0.18" /> </transform>
                              <models> <model file="sphere_1_20_20.3d"><texture file="plutomap1k.jpg" /></model> </models>
                         </group>
                    </group>
                </group>
            </group>

        </group> <!-- End of Planetary System Group -->
    </group> <!-- End of Sun's Group -->
</world>