<world>
    <window width="1024" height="768" />
    <camera>
        <!-- Adjusted camera position for a wider view -->
        <position x="0" y="70" z="150" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="10000" />
    </camera>

    <lights>
        <!-- Central Point Light representing the Sun's light -->
        <light type="point" posx="0" posy="0" posz="0" />
        <!-- Optional: Add a dim ambient light if needed -->
        <!-- <light type="directional" dirx="0" diry="-1" dirz="-1" /> -->
    </lights>

    <!-- Sun (center) -->
    <group>
        <transform>
            <!-- Only axial rotation and scale for the Sun itself -->
            <rotate time="60" x="0" y="1" z="0" />
            <scale x="8" y="8" z="8" />
        </transform>
        <models>
            <model file="sphere_1_20_20.3d" >
                <texture file="sunmap.jpg" />
                <color>
                    <diffuse R="0" G="0" B="0" />
                    <ambient R="0" G="0" B="0" />
                    <specular R="0" G="0" B="0" />
                    <emissive R="255" G="220" B="180" />
                    <shininess value="0" />
                </color>
            </model>
        </models>

        <!-- Planetary System Group (Relative to Sun) -->
        <!-- This outer group is important if you add more top-level items later -->
        <group>
            <!-- Mercury -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation (Fastest Orbit) -->
                    <rotate time="8.8" x="0" y="1" z="0" />
                    <!-- 2. Translate out to orbital distance -->
                    <translate x="15" y="0" z="0" />
                    <!-- 3. Self Rotation (Slow) -->
                    <rotate time="100" x="0" y="1" z="0" />
                    <!-- 4. Scale Planet -->
                    <scale x="0.38" y="0.38" z="0.38" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="mercurymap.jpg" />
                    </model>
                </models>
            </group>

            <!-- Venus -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="22.5" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="20" y="0" z="0" />
                    <!-- 3. Self Rotation (Slow Retrograde) -->
                    <rotate time="-120" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="0.95" y="0.95" z="0.95" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="venusmap.jpg" />
                    </model>
                </models>
            </group>

            <!-- Earth -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="36.5" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="28" y="0" z="0" />
                    <!-- 3. Self Rotation -->
                    <rotate time="10" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="1.0" y="1.0" z="1.0" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="earthmap1k.jpg" />
                    </model>
                </models>
            </group>

            <!-- Mars -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="68.7" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="38" y="0" z="0" />
                     <!-- 3. Self Rotation -->
                    <rotate time="11" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="0.53" y="0.53" z="0.53" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="mars_1k_color.jpg" />
                    </model>
                </models>
            </group>

            <!-- Jupiter -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="433" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="55" y="0" z="0" />
                    <!-- 3. Self Rotation -->
                    <rotate time="4" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="4.0" y="4.0" z="4.0" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="jupitermap.jpg" />
                    </model>
                </models>
            </group>

            <!-- Saturn -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="1075" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="75" y="0" z="0" />
                    <!-- 3. Self Rotation -->
                    <rotate time="4.5" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="3.5" y="3.5" z="3.5" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="saturnmap.jpg" />
                    </model>
                </models>
                 <!-- Rings would be a SUB-GROUP here, relative to Saturn's center -->
            </group>

            <!-- Uranus -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="3068" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="95" y="0" z="0" />
                    <!-- 3. Self Rotation (Tilted Axis) -->
                    <rotate time="-7" x="1" y="0" z="0" /> <!-- Rotate around X for tilt -->
                    <!-- 4. Scale -->
                    <scale x="2.0" y="2.0" z="2.0" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="uranusmap.jpg" />
                    </model>
                </models>
            </group>

            <!-- Neptune -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="6019" x="0" y="1" z="0" />
                    <!-- 2. Translate out -->
                    <translate x="115" y="0" z="0" />
                    <!-- 3. Self Rotation -->
                    <rotate time="7" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="1.9" y="1.9" z="1.9" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="neptunemap.jpg" />
                    </model>
                </models>
            </group>

            <!-- Pluto (Dwarf Planet) -->
            <group>
                <transform>
                    <!-- 1. Orbit Rotation -->
                    <rotate time="9056" x="0" y="1" z="0" />
                    <!-- 2. Translate out (with simplified inclination/eccentricity) -->
                    <translate x="135" y="5" z="10" />
                    <!-- 3. Self Rotation -->
                    <rotate time="-30" x="0" y="1" z="0" />
                    <!-- 4. Scale -->
                    <scale x="0.18" y="0.18" z="0.18" />
                </transform>
                <models>
                    <model file="sphere_1_20_20.3d" >
                         <texture file="plutomap1k.jpg" />
                    </model>
                </models>
            </group>

        </group> <!-- End of Planetary System Group -->
    </group> <!-- End of Sun's Group -->
</world>