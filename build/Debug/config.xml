<world>
    <window width="800" height="600"/>
    <camera>
        <position x="5" y="5" z="5"/>
        <lookAt x="0" y="0" z="0"/>
        <up x="0" y="1" z="0"/>
        <projection fov="60" near="1" far="1000"/>
    </camera>
    <group>
        <transform>
            <translate x="2" y="0" z="0"/>
            <rotate angle="45" x="0" y="1" z="0"/>
        </transform>
        <models>
            <model file="box.3d"/>
        </models>
        <group>
            <transform>
                <translate x="1" y="1" z="0"/>
                <scale x="0.5" y="0.5" z="0.5"/>
            </transform>
            <models>
                <model file="sphere.3d"/>
            </models>
        </group>
    </group>
</world>